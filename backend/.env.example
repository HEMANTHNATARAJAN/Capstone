# Database Configuration (PostgreSQL by default, falls back to SQLite for instant local test runs if PG is not yet spun up)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bookworm_db
# For lightweight standalone testing without PG service:
# DATABASE_URL=sqlite+aiosqlite:///./bookworm.db

# Security & Session Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
SESSION_COOKIE_NAME=bookworm_session
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Settings
HOST=127.0.0.1
PORT=8000
